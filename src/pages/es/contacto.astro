---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL, LEGAL, SITE_NAMES, SITE_URL, AUTHOR_NAME, LAST_UPDATED } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
const lang = 'es';
---
<PageLayout title={'Contacto de GLP-1 Cost Check: señale un precio o un error'} description={'Escriba a GLP-1 Cost Check para señalar un precio que cambió, una cifra errónea o un medicamento que falta. No podemos dar consejo médico ni vender medicamentos.'} lang={lang} noindex={true} breadcrumbs={[{ label: 'Contacto' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contacto</h1>
    <p>Escriba a <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>: un precio que cambió, una regla de Medicare mal indicada, un cambio de Medicaid en su estado. Indique la dirección de la página y, si puede, la página oficial con la cifra correcta.</p>
    <p>No podemos responder preguntas médicas ni vender medicamentos; para eso, consulte a su médico, a su plan, al 1-800-MEDICARE o a la agencia de Medicaid de su estado.</p>
    <p>Para insertar la calculadora en su sitio, vea la <a href={route('widget', lang)}>página de inserción</a>.</p>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>

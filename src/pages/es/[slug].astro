---
/** Pages de contenu en espagnol : seulement celles qui ont une version `es`. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/pages';
import type { PageDef } from '../../lib/page-types';
export function getStaticPaths() { return PAGES.filter((p) => p.es).map((page) => ({ params: { slug: page.es!.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="es" />

---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/glp1-cost-calculator/" title="GLP-1 cost calculator 2026" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the GLP-1 Cost Calculator 2026 on Your Site, Free" description="Embed the 2026 GLP-1 cost calculator in an iframe for free: one code to copy, no sign-up, no cookie, prices refreshed weekly from TrumpRx, the makers and CMS." lang={lang} noindex={true} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the GLP-1 cost calculator</h1>
  <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up, no fee. Clinics, pharmacists, patient groups and local newsrooms can give readers a dated, sourced price in a minute.</p></header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not alter it, no warranty. Prices refresh here every week, so your page stays current. Spanish version: <code>{`${SITE_URL}/embed/calculadora-costo-glp1/`}</code>. The iframe writes no cookie and sends us nothing your visitors type. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/glp1-cost-calculator/" title="GLP-1 cost calculator 2026" width="100%" height="1000" style="border:0" loading="lazy"></iframe></div>
</PageLayout>

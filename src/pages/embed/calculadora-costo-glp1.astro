---
/** Page embarquable (iframe) : calculateur sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import GlpCalculator from '../../components/calc/GlpCalculator';
import { SITE_URL } from '../../data/site-config';
const home = `${SITE_URL}/es/`;
---
<!doctype html>
<html lang="es-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>US GLP Cost widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <GlpCalculator client:load lang="es" productId="wegovy" methodHref={home} idPrefix="emb" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={home} target="_blank" rel="noopener" class="underline">US GLP Cost</a> · cálculo en su navegador, estimación indicativa</p>
  </body>
</html>
